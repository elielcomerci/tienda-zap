# Variables de entorno — ZAP Tienda
# Copiar a .env.local y completar los valores

# Base de datos PostgreSQL (Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="genera-con-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# En producción: NEXTAUTH_URL="https://tienda.zap.com.ar"

# Vercel Blob (se genera automáticamente al vincular el Blob store)
BLOB_READ_WRITE_TOKEN=""

# MercadoPago
MP_ACCESS_TOKEN="APP_USR-..."
MP_WEBHOOK_SECRET=""
NEXT_PUBLIC_MP_PUBLIC_KEY="APP_USR-..."

# Transferencia bancaria: la opción solo aparece en el checkout cuando hay alias y CBU/CVU.
# Estos datos son públicos y también se muestran en la confirmación del pedido.
NEXT_PUBLIC_TRANSFER_ALIAS=""
NEXT_PUBLIC_TRANSFER_ACCOUNT_NUMBER=""
NEXT_PUBLIC_TRANSFER_ACCOUNT_HOLDER=""
NEXT_PUBLIC_TRANSFER_TAX_ID=""
# Set to false to hide new Crédito ZAP offers and requests. Existing plans remain accessible.
NEXT_PUBLIC_ZAP_CREDIT_ENABLED="false"

# Contacto comercial
NEXT_PUBLIC_WHATSAPP_NUMBER="+541125832323"

# Admin inicial
ADMIN_EMAIL="admin@zap.com.ar"
ADMIN_PASSWORD="cambiar_esta_clave"

# Cloudflare R2 (media.zap.com.ar)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Bucket privado sin dominio público para propuestas y archivos nuevos de clientes.
R2_PRIVATE_BUCKET_NAME=""
# Mantener desactivado hasta aplicar el SQL y completar pruebas de seguridad
CLIENT_WORK_FILES_ENABLED="false"

# Integración con kiosco24 (Impresión Premium / Crédito Partner)
KIOSCO24_BASE_URL="http://localhost:3001"
# Secret compartido con kiosco24 — debe coincidir con PARTNER_INTERNAL_SECRET allá
PARTNER_INTERNAL_SECRET="cambiar_esta_clave_compartida"


# Integración con ZAP Fiscal Worker (solo servidor; nunca NEXT_PUBLIC_)
FISCAL_WORKER_URL="https://arca.zap.com.ar" # Opcional: por defecto usa https://arca.zap.com.ar
INTERNAL_SECRET="configurar_el_INTERNAL_SECRET_del_Worker"
TENANT_PROVISIONING_SECRET="configurar_el_TENANT_PROVISIONING_SECRET_del_Worker"
PUBLIC_PADRON_BACKEND_SECRET="configurar_el_secreto_dedicado_de_consulta_publica"

# Emisión automática de facturas de pedidos (solo servidor).
# La API_KEY es la clave X-Api-Key del tenant ZAP en el Worker, no un secreto interno.
API_KEY=""
# Tenant emisor de ZAP en TEST; el POS 1 figura en el registro local del Worker.
FISCAL_ORDER_ACCOUNT_ID=""
FISCAL_ORDER_CONTRIBUTOR_CUIT="20321601058"
FISCAL_ORDER_POINT_OF_SALE="1" # En producción, el punto de venta configurado es 3.
FISCAL_ORDER_ENVIRONMENT="TEST"

# Cifrado de credenciales API del Fiscal Worker guardadas para soporte de clientes.
# Generar una clave aleatoria de 32 bytes y codificarla en base64. Solo servidor.
FISCAL_CREDENTIALS_ENCRYPTION_KEY=""
