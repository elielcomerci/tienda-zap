{
  "name": "zap-tienda",
  "version": "0.1.0",
  "description": "E-commerce completo minimalista para imprenta/gráfica. Creado con Next.js 15, Prisma 7, Auth.js v5 y Tailwind CSS.",
  "private": true,
  "main": "postcss.config.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node --compilerOptions \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "postinstall": "prisma generate",
    "test": "node scripts/run-ts-tests.cjs tests/configurator-contract.test.ts tests/checkout-pricing-smoke.test.ts tests/crypto-networks.test.ts tests/crypto-quotes.test.ts tests/crypto-submit-concurrency.test.ts tests/crypto-reconciliation-simulation.test.ts tests/fiscal-integration-keys.test.ts tests/fiscal-invoice-batches.test.ts",
    "typecheck": "tsc --noEmit",
    "test:crypto": "node scripts/run-ts-tests.cjs tests/crypto-networks.test.ts tests/crypto-quotes.test.ts tests/crypto-submit-concurrency.test.ts tests/crypto-reconciliation-simulation.test.ts",
    "test:integration:pricing": "node scripts/run-ts-tests.cjs tests/pricing-db.integration.test.ts",
    "prebuild": "node scripts/run-prebuild-tests.cjs"
  },
  "prisma": {
    "seed": "ts-node --compilerOptions \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1018.0",
    "@aws-sdk/s3-request-presigner": "^3.1018.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/blob": "^2.3.1",
    "@yudiel/react-qr-scanner": "^2.5.1",
    "autoprefixer": "^10.4.27",
    "bcryptjs": "^3.0.3",
    "geist": "^1.5.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.7.0",
    "mercadopago": "^3.6.1",
    "next": "^16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "postcss": "^8.5.8",
    "prisma": "^7.5.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "resend": "^6.12.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "ts-node": "^10.9.2"
  }
}
